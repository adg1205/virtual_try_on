<%- include('partials/header') %>
<section class="auth-section container-sm px-3 py-5">
    <div class="auth-box glass-panel card text-light border-0 shadow-lg p-4 p-md-5">
        <h2 class="card-title text-center">Reset Password</h2>
        <form action="/reset-password/<%= token %>" method="POST">
            <div class="form-group mb-4">
                <label for="password" class="form-label">New Password</label>
                <input type="password" id="password" name="password" class="form-control" autocomplete="new-password" required>
            </div>
            <div class="d-grid">
                <button type="submit" class="btn btn-primary btn-full w-100">Reset Password</button>
            </div>
        </form>
    </div>
</section>
<%- include('partials/footer') %>
