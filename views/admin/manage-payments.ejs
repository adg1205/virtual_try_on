<%- include('../partials/header') %>
<div class="dashboard-layout d-grid">
    <%- include('../partials/admin-sidebar') %>
    <section class="dashboard-content w-100">
        <div class="dashboard-header d-flex align-items-center justify-content-between gap-3">
            <h2 class="mb-0">Manage Payments</h2>
        </div>
        <div class="dashboard-body container-fluid px-0">
            
            <div class="data-table-wrapper glass-panel table-responsive p-2 p-md-4">
                <table class="data-table table table-dark table-hover align-middle mb-0">
                    <thead>
                        <tr><th>Payment ID</th><th>Order ID</th><th>Customer</th><th>Amount</th><th>Method</th><th>Status</th><th>Date</th></tr>
                    </thead>
                    <tbody>
                        <tr><td colspan="7" class="text-muted text-center py-5">No payments recorded.</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</div>
<%- include('../partials/footer') %>
