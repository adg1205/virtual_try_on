<%- include('../partials/header') %>
<div class="dashboard-layout d-grid">
    <%- include('../partials/admin-sidebar') %>
    <section class="dashboard-content w-100">
        <div class="dashboard-header d-flex align-items-center justify-content-between gap-3">
            <h2 class="mb-0">Manage Frames</h2>
        </div>
        <div class="dashboard-body container-fluid px-0">
            
            <div class="toolbar d-flex flex-column flex-sm-row justify-content-sm-end gap-2">
                <a href="/admin/add-frame" class="btn btn-primary px-3">+ Add New Frame</a>
            </div>
            <div class="data-table-wrapper glass-panel table-responsive p-2 p-md-4">
                <table class="data-table table table-dark table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Image</th>
                            <th>Name</th>
                            <th>Brand</th>
                            <th>Price</th>
                            <th>Stock</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="7" class="text-muted text-center py-5">No frames found. Add one to get started.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</div>
<%- include('../partials/footer') %>
