<%- include('../partials/header') %>
<div class="dashboard-layout d-grid">
    <%- include('../partials/admin-sidebar') %>
    <section class="dashboard-content w-100">
        <div class="dashboard-header d-flex align-items-center justify-content-between gap-3">
            <h2 class="mb-0">Admin Dashboard</h2>
        </div>
        <div class="dashboard-body container-fluid px-0">
            
            <div class="stats-grid d-grid gap-3">
                <div class="stat-card glass-panel card h-100 text-light border-0 shadow-sm">
                    <div class="stat-icon">👓</div>
                    <div class="stat-info">
                        <h3>Total Frames</h3>
                        <p class="stat-number">0</p>
                    </div>
                </div>
                <div class="stat-card glass-panel card h-100 text-light border-0 shadow-sm">
                    <div class="stat-icon">📦</div>
                    <div class="stat-info">
                        <h3>Pending Orders</h3>
                        <p class="stat-number">0</p>
                    </div>
                </div>
                <div class="stat-card glass-panel card h-100 text-light border-0 shadow-sm">
                    <div class="stat-icon">👥</div>
                    <div class="stat-info">
                        <h3>Customers</h3>
                        <p class="stat-number">0</p>
                    </div>
                </div>
                <div class="stat-card glass-panel card h-100 text-light border-0 shadow-sm">
                    <div class="stat-icon">💰</div>
                    <div class="stat-info">
                        <h3>Revenue</h3>
                        <p class="stat-number">$0.00</p>
                    </div>
                </div>
            </div>
            <div class="recent-section glass-panel card text-light border-0 shadow-sm mt-4 p-3 p-md-4">
                <h3>Recent Activity</h3>
                <p class="text-muted">No recent activity to display.</p>
            </div>
        </div>
    </section>
</div>
<%- include('../partials/footer') %>
