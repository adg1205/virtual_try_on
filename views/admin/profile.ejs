<%- include('../partials/header') %>
<div class="dashboard-layout d-grid">
    <%- include('../partials/admin-sidebar') %>
    <section class="dashboard-content w-100">
        <div class="dashboard-header d-flex align-items-center justify-content-between gap-3">
            <h2 class="mb-0">Admin Profile</h2>
        </div>
        <div class="dashboard-body container-fluid px-0">
            
            <div class="form-card glass-panel card text-light border-0 shadow-sm p-3 p-md-4 mx-auto mx-lg-0" style="max-width: 600px;">
                <div class="profile-header text-center mb-4">
                    <div class="profile-avatar" style="width: 100px; height: 100px; border-radius: 50%; background: rgba(99,102,241,0.3); display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem; font-size: 2.5rem;">👤</div>
                    <h3><%= user.name %></h3>
                    <p class="text-muted"><%= user.email %></p>
                </div>
                <form>
                    <div class="form-group mb-3">
                        <label for="name" class="form-label">Full Name</label>
                        <input type="text" id="name" name="name" class="form-control" value="<%= user.name %>">
                    </div>
                    <div class="form-group mb-4">
                        <label for="email" class="form-label">Email</label>
                        <input type="email" id="email" name="email" class="form-control" value="<%= user.email %>" readonly>
                    </div>
                    <button type="submit" class="btn btn-primary px-4">Update Profile</button>
                </form>
            </div>
        </div>
    </section>
</div>
<%- include('../partials/footer') %>
