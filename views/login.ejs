<%- include('partials/header') %>

<section class="auth-section container-sm px-3 py-5">
    <div class="auth-box glass-panel card text-light border-0 shadow-lg p-4 p-md-5">
        <h2 class="card-title text-center">Login</h2>
        <form action="/login" method="POST">
            <div class="form-group mb-3">
                <label for="email" class="form-label">Email</label>
                <input type="email" id="email" name="email" class="form-control" autocomplete="email" required>
            </div>
            <div class="form-group mb-4">
                <label for="password" class="form-label">Password</label>
                <input type="password" id="password" name="password" class="form-control" autocomplete="current-password" required>
            </div>
            <div class="d-grid">
                <button type="submit" class="btn btn-primary btn-full w-100">Sign In</button>
            </div>
        </form>
        <p class="auth-link mt-3"><a href="/forgot-password" style="color: var(--primary-color, #6366f1); font-weight: 600;">Forgot your password?</a></p>
        <p class="auth-link">Don't have an account? <a href="/signup">Sign up here</a>.</p>
    </div>
</section>

<%- include('partials/footer') %>
