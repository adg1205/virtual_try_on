<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/bootstrap-integration.css">
    <link rel="stylesheet" href="/css/components/index.css">
    <link rel="stylesheet" href="/dist/style.css">
    <% if (typeof loadMap !== 'undefined' && loadMap) { %>
        <!-- Leaflet CSS & JS for MapTiler integration -->
        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <% } %>
</head>

<body class="bootstrap-app">
    <nav class="navbar navbar-expand-lg navbar-dark app-navbar" aria-label="Primary navigation">
        <div class="container-fluid px-0">
            <div class="logo">
                <a href="/" class="navbar-brand mb-0">VirtualTryOn</a>
            </div>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#primaryNavigation" aria-controls="primaryNavigation" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="primaryNavigation">
                <ul class="navbar-nav nav-links mx-lg-auto mb-3 mb-lg-0">
                    <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="/catalog">Catalog</a></li>
                    <li class="nav-item"><a class="nav-link" href="/about">About</a></li>
                    <li class="nav-item"><a class="nav-link" href="/contact">Contact</a></li>
                </ul>
                <div class="auth-buttons d-flex flex-column flex-lg-row align-items-stretch align-items-lg-center gap-2">
                    <% if (locals.user) { %>
                        <% if (locals.user.role === 'admin') { %>
                            <a href="/admin/dashboard" class="btn btn-secondary">Dashboard</a>
                        <% } else { %>
                            <a href="/customer/dashboard" class="btn btn-secondary">Dashboard</a>
                        <% } %>
                        <a href="/logout" class="btn btn-primary">Logout</a>
                    <% } else { %>
                        <a href="/login" class="btn btn-secondary">Login</a>
                        <a href="/signup" class="btn btn-primary">Sign Up</a>
                    <% } %>
                </div>
            </div>
        </div>
    </nav>
    <main class="container-fluid app-main px-0">
