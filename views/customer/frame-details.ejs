<%- include('../partials/header') %>
<% const isFixedSportLens = /sports? wrap/i.test(frame.name || '')
    || /\/(?:sport|sport_(?:front|overlay))\.(?:png|svg)(?:[?#]|$)/i.test(frame.image_url || ''); %>
<div class="dashboard-layout">
    <%- include('../partials/customer-sidebar') %>
    <section class="dashboard-content container-fluid">
        <div class="dashboard-header">
            <div class="d-flex flex-column flex-sm-row align-items-sm-center gap-3">
                <a href="/customer/frame-catalog" class="btn btn-secondary btn-sm fd-back-btn">← Back to Catalog</a>
                <h2><%= frame.name %></h2>
            </div>
        </div>
        <div class="dashboard-body">

            <div class="frame-detail-layout">

                <!-- LEFT: Image Panel -->
                <div class="frame-detail-image-panel glass-panel">
                    <img src="<%= frame.image_url %>"
                         alt="<%= frame.name %>"
                         class="frame-detail-img img-fluid"
                         onerror="this.src='https://placehold.co/600x400/1a1a2e/a78bfa?text=🕶️+<%= encodeURIComponent(frame.name) %>'">
                    <!-- Lens Tint Visual Overlay -->
                    <div id="lensTintOverlay" class="lens-tint-overlay"></div>
                    <span id="tintLabelBadge" class="tint-label-badge d-none"></span>
                    <!-- Availability Overlay Badge -->
                    <span class="fd-availability-badge <%= frame.availability ? 'badge-in-stock' : 'badge-out-of-stock' %>">
                        <span class="badge-dot"></span>
                        <%= frame.availability ? 'In Stock' : 'Out of Stock' %>
                    </span>
                </div>

                <!-- RIGHT: Info Panel -->
                <div class="frame-detail-info">

                    <div class="fd-brand"><%= frame.brand %></div>
                    <h1 class="fd-name"><%= frame.name %></h1>
                    <p class="fd-price">৳<%= Number(frame.price).toFixed(2) %></p>

                    <div class="fd-divider"></div>

                    <!-- Specs Grid -->
                    <div class="fd-specs-grid">
                        <div class="fd-spec-item">
                            <span class="fd-spec-label">🔷 Shape</span>
                            <span class="fd-spec-value"><%= frame.shape %></span>
                        </div>
                        <div class="fd-spec-item">
                            <span class="fd-spec-label">🎨 Color</span>
                            <span class="fd-spec-value"><%= frame.color %></span>
                        </div>
                        <div class="fd-spec-item">
                            <span class="fd-spec-label">⚙️ Material</span>
                            <span class="fd-spec-value"><%= frame.material %></span>
                        </div>
                        <div class="fd-spec-item">
                            <span class="fd-spec-label">🆔 Frame ID</span>
                            <span class="fd-spec-value">#<%= frame.id %></span>
                        </div>
                    </div>
                    <div class="fd-divider"></div>

                    <!-- Customize Style Selection (Vue Island: CustomizePanel) -->
                    <div
                        id="vue-customize-panel"
                        data-vue-component="CustomizePanel"
                        data-vue-props='<%- JSON.stringify({ frame, isFixedSportLens }) %>'
                    >
                        <!-- SSR Fallback -->
                        <div class="fd-customization glass-panel fd-customization-panel">
                            <h4 class="fd-customization-title">✨ Customize Your Style</h4>
                            <div class="fd-customization-grid">
                                <div class="form-group mb-0">
                                    <label class="fd-custom-label">🎨 Frame Color: <strong><%= frame.color %></strong></label>
                                </div>
                                <div class="form-group mb-0">
                                    <label class="fd-custom-label">👁️ Lens Option: <strong>Clear Lens</strong></label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="fd-divider"></div>

                    <!-- Action Buttons -->
                    <div class="fd-actions">
                        <a id="tryOnBtn" href="/customer/virtual-try-on?frameId=<%= frame.id %>" class="btn btn-primary fd-btn">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/></svg>
                            Try On Virtually
                        </a>
                        <% if (frame.availability) { %>
                            <button id="addToCartBtn" class="btn btn-secondary fd-btn" data-frame-id="<%= frame.id %>" data-price="<%= frame.price %>">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
                                Add to Cart
                            </button>
                        <% } else { %>
                            <button class="btn btn-secondary fd-btn btn-disabled-frame" disabled>
                                Unavailable
                            </button>
                        <% } %>
                        <button class="btn btn-secondary fd-btn <%= isWishlisted ? 'text-danger' : '' %>" id="wishlistBtn" data-wishlisted="<%= isWishlisted %>">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="<%= isWishlisted ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
                            <span id="wishlistBtnText"><%= isWishlisted ? 'Remove from Wishlist' : 'Add to Wishlist' %></span>
                        </button>
                    </div>

                </div>
            </div>

            <!-- Similar Frame Suggestions Section -->
            <% if (locals.similarFrames && similarFrames.length > 0) { %>
                <div class="similar-frames-section">
                    <div class="similar-frames-header">
                        <div>
                            <h3 class="similar-frames-title">
                                <span>✨</span> You May Also Like
                            </h3>
                            <p class="similar-frames-subtitle">
                                Similar frame suggestions based on shape, material, color, and price range
                            </p>
                        </div>
                    </div>

                    <div class="similar-frames-grid">
                        <% similarFrames.forEach(sFrame => { %>
                            <% const isOOS = !sFrame.availability || sFrame.isOutOfStock; %>
                            <div class="frame-card glass-panel <%= isOOS ? 'frame-card-oos' : '' %>">
                                <div class="frame-card-image-wrap" onclick="window.location.href='/customer/frame-details/<%= sFrame.id %>'" style="cursor: pointer;">
                                    <img src="<%= sFrame.image_url %>" 
                                         alt="<%= sFrame.name %>" 
                                         class="frame-card-img img-fluid">
                                    
                                    <% 
                                        let matchBadgeClass = 'badge-match-high';
                                        if (sFrame.similarityScore < 50) matchBadgeClass = 'badge-match-low';
                                        else if (sFrame.similarityScore < 75) matchBadgeClass = 'badge-match-mid';
                                    %>
                                    <span class="similarity-badge <%= matchBadgeClass %>">
                                        🎯 <%= sFrame.similarityScore %>% Match
                                    </span>

                                    <span class="availability-badge <%= sFrame.availability ? 'badge-in-stock' : 'badge-out-of-stock' %>">
                                        <span class="badge-dot"></span>
                                        <%= sFrame.availability ? 'In Stock' : 'Out of Stock' %>
                                    </span>
                                </div>

                                <div class="frame-card-body">
                                    <div class="d-flex justify-content-between align-items-start gap-2">
                                        <div>
                                            <h4 class="frame-card-title"><%= sFrame.name %></h4>
                                            <span class="frame-card-brand"><%= sFrame.brand %></span>
                                        </div>
                                        <span class="frame-card-price">৳<%= Number(sFrame.price).toFixed(2) %></span>
                                    </div>

                                    <div class="frame-card-tags">
                                        <span class="frame-tag tag-shape">🔷 <%= sFrame.shape %></span>
                                        <span class="frame-tag tag-material">💎 <%= sFrame.material %></span>
                                        <span class="frame-tag tag-color">🎨 <%= sFrame.color %></span>
                                    </div>

                                    <!-- Out of Stock Alternative Suggestion Row -->
                                    <% if (isOOS && sFrame.alternative) { %>
                                        <div class="oos-alternative-box" style="background: rgba(99, 102, 241, 0.12); border: 1px solid rgba(99, 102, 241, 0.35); border-radius: 8px; padding: 0.5rem 0.6rem; margin-top: 0.5rem;" onclick="event.stopPropagation();">
                                            <div style="font-size: 0.7rem; font-weight: 700; color: #a5b4fc; margin-bottom: 0.25rem; display: flex; align-items: center; gap: 0.2rem;">
                                                <span>💡</span> In-Stock Alternative:
                                            </div>
                                            <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.4rem;">
                                                <div style="display: flex; align-items: center; gap: 0.4rem; min-width: 0;">
                                                    <div style="width: 28px; height: 20px; background: rgba(0,0,0,0.3); border-radius: 4px; overflow: hidden; flex-shrink: 0; display: flex; align-items: center; justify-content: center;">
                                                        <img src="<%= sFrame.alternative.image_url %>" alt="<%= sFrame.alternative.name %>" class="img-fluid" style="max-width: 100%; max-height: 100%; object-fit: contain;">
                                                    </div>
                                                    <div style="min-width: 0;">
                                                        <p style="font-size: 0.75rem; font-weight: 700; color: #fff; margin: 0; text-overflow: ellipsis; overflow: hidden; white-space: nowrap;"><%= sFrame.alternative.name %></p>
                                                        <span style="font-size: 0.68rem; color: var(--secondary-color); font-weight: 600;">৳<%= Number(sFrame.alternative.price).toFixed(2) %></span>
                                                    </div>
                                                </div>
                                                <a href="/customer/frame-details/<%= sFrame.alternative.id %>" class="btn btn-secondary btn-sm" style="font-size: 0.68rem; padding: 2px 6px; border-radius: 4px; flex-shrink: 0;">View →</a>
                                            </div>
                                        </div>
                                    <% } %>

                                    <a href="/customer/frame-details/<%= sFrame.id %>" class="btn btn-secondary btn-full py-2 small mt-2">
                                        View Details →
                                    </a>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                </div>
            <% } %>

            <!-- CUSTOMER REVIEWS & RATINGS SECTION -->
            <div class="reviews-section" id="reviewsSection">
                <div class="reviews-header" style="margin-top: 2.5rem; margin-bottom: 1.5rem;">
                    <h3 style="font-size: 1.5rem; font-weight: 800; color: #fff; margin: 0 0 0.4rem 0; display: flex; align-items: center; gap: 0.6rem;">
                        <span>⭐</span> Customer Reviews & Ratings
                    </h3>
                    <p style="color: var(--text-muted, #9ca3af); font-size: 0.95rem; margin: 0;">
                        Read genuine feedback from customers who tried or ordered <%= frame.name %>
                    </p>
                </div>

                <!-- REVIEW SUMMARY STATS PANEL -->
                <div class="glass-panel review-stats-panel">
                    <div class="review-stats-grid">
                        
                        <!-- LEFT: Big Average Score -->
                        <div class="stat-score-box">
                            <div class="big-score-val"><%= reviewStats.average_rating ? reviewStats.average_rating.toFixed(1) : '0.0' %></div>
                            <div class="stars-row-lg">
                                <% const avg = Math.round(reviewStats.average_rating || 0); %>
                                <% for (let i = 1; i <= 5; i++) { %>
                                    <span class="star-icon <%= i <= avg ? 'filled' : '' %>">★</span>
                                <% } %>
                            </div>
                            <div class="total-reviews-count">
                                <%= reviewStats.total_reviews %> <%= reviewStats.total_reviews === 1 ? 'Review' : 'Reviews' %>
                            </div>
                        </div>

                        <!-- RIGHT: Rating Breakdown Bars -->
                        <div class="stat-bars-box">
                            <% 
                                const total = reviewStats.total_reviews || 1;
                                const breakdown = [
                                    { stars: 5, count: reviewStats.count_5 || 0 },
                                    { stars: 4, count: reviewStats.count_4 || 0 },
                                    { stars: 3, count: reviewStats.count_3 || 0 },
                                    { stars: 2, count: reviewStats.count_2 || 0 },
                                    { stars: 1, count: reviewStats.count_1 || 0 }
                                ];
                            %>
                            <% breakdown.forEach(b => { %>
                                <% const pct = Math.round((b.count / total) * 100); %>
                                <div class="rating-bar-row">
                                    <span class="bar-star-label"><%= b.stars %> ★</span>
                                    <div class="rating-bar-bg">
                                        <div class="rating-bar-fill" style="width: <%= pct %>%;"></div>
                                    </div>
                                    <span class="bar-count-label"><%= b.count %></span>
                                </div>
                            <% }); %>
                        </div>

                    </div>
                </div>

                <!-- USER REVIEW STATUS & FORM AREA -->
                <div class="review-form-area" style="margin-top: 1.5rem;">
                    <% if (isEligibleToReview) { %>

                        <!-- Existing User Review Card (if already reviewed) -->
                        <% if (userReview) { %>
                            <div class="glass-panel my-existing-review-panel" id="myExistingReviewPanel">
                                <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem;">
                                    <div>
                                        <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.4rem;">
                                            <span style="font-size: 0.78rem; font-weight: 700; text-transform: uppercase; background: rgba(124, 58, 237, 0.25); border: 1px solid rgba(124, 58, 237, 0.4); color: #c4b5fd; padding: 0.2rem 0.65rem; border-radius: 50px;">Your Review</span>
                                            <span style="font-size: 0.8rem; color: var(--text-muted, #9ca3af);">
                                                Updated on <%= new Date(userReview.updated_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                                            </span>
                                        </div>
                                        <div class="stars-row-sm" style="margin-bottom: 0.5rem;">
                                            <% for (let i = 1; i <= 5; i++) { %>
                                                <span class="star-icon <%= i <= userReview.rating ? 'filled' : '' %>">★</span>
                                            <% } %>
                                        </div>
                                        <% if (userReview.comment) { %>
                                            <p style="margin: 0; color: #e2e8f0; font-size: 0.95rem; line-height: 1.5;"><%= userReview.comment %></p>
                                        <% } else { %>
                                            <p style="margin: 0; color: var(--text-muted, #9ca3af); font-style: italic; font-size: 0.88rem;">No written comment provided.</p>
                                        <% } %>
                                    </div>
                                    <div style="display: flex; gap: 0.5rem;">
                                        <button type="button" id="editReviewToggleBtn" class="btn btn-secondary btn-sm" style="border-radius: 50px; font-size: 0.82rem; padding: 0.4rem 1rem;">
                                            ✏️ Edit Review
                                        </button>
                                        <button type="button" id="deleteMyReviewBtn" data-review-id="<%= userReview.id %>" class="btn btn-sm" style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.3); color: #fca5a5; border-radius: 50px; font-size: 0.82rem; padding: 0.4rem 1rem; cursor: pointer; transition: all 0.2s;">
                                            🗑️ Delete
                                        </button>
                                    </div>
                                </div>
                            </div>
                        <% } %>

                        <!-- Review Submission Form (shown if no review yet OR when editing) -->
                        <div class="glass-panel review-form-card" id="reviewFormCard" style="<%= userReview ? 'display: none;' : '' %>">
                            <h4 style="margin: 0 0 1rem 0; font-size: 1.15rem; font-weight: 700; color: #fff;">
                                <%= userReview ? '✏️ Edit Your Review' : '✍️ Write a Review' %>
                            </h4>

                            <form id="reviewSubmitForm">
                                <input type="hidden" name="frameId" value="<%= frame.id %>">
                                
                                <div class="form-group" style="margin-bottom: 1.25rem;">
                                    <label style="display: block; font-size: 0.88rem; font-weight: 700; color: #e2e8f0; margin-bottom: 0.5rem;">
                                        Your Rating <span style="color: #ef4444;">*</span>
                                    </label>
                                    
                                    <div style="display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;">
                                        <div class="star-rating-input" id="starRatingInput">
                                            <% const activeRating = userReview ? userReview.rating : 5; %>
                                            <% for (let i = 1; i <= 5; i++) { %>
                                                <span class="star-btn <%= i <= activeRating ? 'active' : '' %>" data-value="<%= i %>">★</span>
                                            <% } %>
                                        </div>
                                        <span id="starRatingLabel" style="font-size: 0.9rem; font-weight: 700; color: #f59e0b;"></span>
                                    </div>
                                    <input type="hidden" id="ratingValueInput" name="rating" value="<%= activeRating %>">
                                </div>

                                <div class="form-group" style="margin-bottom: 1.25rem;">
                                    <label for="reviewComment" style="display: block; font-size: 0.88rem; font-weight: 700; color: #e2e8f0; margin-bottom: 0.5rem;">
                                        Your Review Comment <span style="color: var(--text-muted, #9ca3af); font-weight: 400; font-size: 0.8rem;">(Optional)</span>
                                    </label>
                                    <textarea id="reviewComment" name="comment" rows="3" class="form-control" placeholder="How do these frames fit? What do you think about the material, lens clarity, or style?" style="width: 100%; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.15); border-radius: 12px; padding: 0.75rem 1rem; color: #fff; font-family: inherit; font-size: 0.95rem; resize: vertical; outline: none; transition: border-color 0.2s;"><%= userReview ? (userReview.comment || '') : '' %></textarea>
                                </div>

                                <div style="display: flex; gap: 0.75rem; align-items: center;">
                                    <button type="submit" id="submitReviewBtn" class="btn btn-primary" style="padding: 0.65rem 1.75rem; border-radius: 50px; font-weight: 700; background: linear-gradient(135deg, #7c3aed, #4f46e5); border: none; cursor: pointer;">
                                        <%= userReview ? 'Update Review' : 'Submit Review' %>
                                    </button>
                                    <% if (userReview) { %>
                                        <button type="button" id="cancelEditReviewBtn" class="btn btn-secondary" style="padding: 0.65rem 1.25rem; border-radius: 50px; font-size: 0.88rem;">
                                            Cancel
                                        </button>
                                    <% } %>
                                </div>
                            </form>
                        </div>

                    <% } else { %>
                        <!-- Ineligible Banner -->
                        <div class="glass-panel" style="padding: 1.25rem 1.5rem; border-radius: 16px; background: rgba(255,255,255,0.02); border: 1px dashed rgba(255,255,255,0.15); display: flex; align-items: center; gap: 1rem;">
                            <span style="font-size: 1.8rem;">💡</span>
                            <div>
                                <h5 style="margin: 0 0 0.2rem 0; font-size: 0.95rem; font-weight: 700; color: #fff;">Want to leave a review?</h5>
                                <p style="margin: 0; font-size: 0.85rem; color: var(--text-muted, #9ca3af);">
                                    You can submit a rating & review after trying on this frame virtually or placing an order for it!
                                </p>
                            </div>
                        </div>
                    <% } %>
                </div>

                <!-- REVIEWS LIST CONTAINER -->
                <div class="reviews-list-container" style="margin-top: 2rem;">
                    <h4 style="font-size: 1.15rem; font-weight: 700; color: #fff; margin-bottom: 1.25rem; display: flex; align-items: center; justify-content: space-between;">
                        <span>Customer Comments</span>
                        <span id="reviewsCountBadge" style="font-size: 0.8rem; font-weight: 600; color: var(--text-muted, #9ca3af);">
                            Showing <%= reviews.length %> of <%= reviewStats.total_reviews %>
                        </span>
                    </h4>

                    <div id="reviewsList" style="display: flex; flex-direction: column; gap: 1rem;">
                        <% if (!reviews || reviews.length === 0) { %>
                            <div id="emptyReviewsState" class="glass-panel" style="padding: 3rem 2rem; text-align: center; border-radius: 16px; background: rgba(255,255,255,0.02);">
                                <div style="font-size: 2.5rem; margin-bottom: 0.75rem;">💬</div>
                                <h5 style="margin: 0 0 0.3rem 0; font-size: 1.1rem; color: #fff; font-weight: 700;">No Reviews Yet</h5>
                                <p style="margin: 0; color: var(--text-muted, #9ca3af); font-size: 0.9rem;">Be the first customer to share your thoughts on <%= frame.name %>!</p>
                            </div>
                        <% } else { %>
                            <% reviews.forEach(rev => { %>
                                <div class="glass-panel review-card-item">
                                    <div class="review-card-header">
                                        <div class="reviewer-info">
                                            <div class="reviewer-avatar">
                                                <%= rev.full_name ? rev.full_name.charAt(0).toUpperCase() : 'U' %>
                                            </div>
                                            <div>
                                                <div class="reviewer-name"><%= rev.full_name %></div>
                                                <div class="review-date">
                                                    <%= new Date(rev.updated_at).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>
                                                </div>
                                            </div>
                                        </div>

                                        <div style="display: flex; align-items: center; gap: 0.75rem;">
                                            <div class="stars-row-sm">
                                                <% for (let i = 1; i <= 5; i++) { %>
                                                    <span class="star-icon <%= i <= rev.rating ? 'filled' : '' %>">★</span>
                                                <% } %>
                                            </div>
                                            <% if (rev.user_id === user.id) { %>
                                                <span style="font-size: 0.7rem; font-weight: 700; background: rgba(124,58,237,0.2); border: 1px solid rgba(124,58,237,0.4); color: #c4b5fd; padding: 0.15rem 0.5rem; border-radius: 50px;">You</span>
                                            <% } %>
                                        </div>
                                    </div>

                                    <% if (rev.comment) { %>
                                        <p class="review-comment-text"><%= rev.comment %></p>
                                    <% } else { %>
                                        <p class="review-comment-text" style="color: var(--text-muted, #9ca3af); font-style: italic;">No written comment.</p>
                                    <% } %>
                                </div>
                            <% }); %>
                        <% } %>
                    </div>

                    <!-- LOAD MORE REVIEWS BUTTON -->
                    <% if (reviewStats.total_reviews > reviews.length) { %>
                        <div style="text-align: center; margin-top: 1.5rem;">
                            <button type="button" id="loadMoreReviewsBtn" data-frame-id="<%= frame.id %>" data-offset="<%= reviews.length %>" class="btn btn-secondary" style="border-radius: 50px; padding: 0.65rem 2rem; font-weight: 700; font-size: 0.9rem;">
                                Load More Reviews 👇
                            </button>
                        </div>
                    <% } %>

                </div>
            </div>

        </div>
    </section>
</div>

<script src="/js/lens-tint-palette.js"></script>
<script>
    window.FRAME_ID = "<%= frame.id %>";
</script>
<script src="/js/frame-details.js" defer></script>

<%- include('../partials/footer') %>
