<%- include('../partials/header') %>
<div class="dashboard-layout">
    <%- include('../partials/customer-sidebar') %>
    <section class="dashboard-content container-fluid">
        <div class="dashboard-header">
            <h2>Virtual Try-On</h2>
        </div>
        <div class="dashboard-body">
            <!-- Vue Island: VirtualTryOn -->
            <div
                id="vue-virtual-try-on"
                data-vue-component="VirtualTryOn"
                data-vue-props='<%- JSON.stringify({ initialFrame: frame || {}, framesList: (typeof frames !== "undefined" ? frames : (frame ? [frame] : [])) }) %>'
            >
                <!-- SSR Fallback -->
                <div id="tryonContainer" class="tryon-container glass-panel p-3 p-md-4">
                    <div class="tryon-preview text-center py-5">
                        <span class="fs-1">📸</span>
                        <h4 class="text-white mt-2">Starting Virtual Try-On Studio...</h4>
                        <p class="small text-muted-custom">Loading interactive 3D face mesh and optical models.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<!-- MediaPipe and Optical Processor Scripts -->
<script src="/js/lens-tint-palette.js"></script>
<script src="/js/frame-overlay-processor.js"></script>
<script src="/js/face-shape-estimator.js"></script>
<script src="/js/virtual-mirror.js"></script>

<%- include('../partials/footer') %>
