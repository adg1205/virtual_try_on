<%- include('../partials/header') %>
<div class="dashboard-layout">
    <%- include('../partials/customer-sidebar') %>
    <section class="dashboard-content container-fluid">
        <div class="dashboard-header d-flex flex-column flex-sm-row justify-content-between align-items-sm-center flex-wrap gap-3">
            <div>
                <h2>Shopping Cart</h2>
                <p class="text-muted-custom mt-1">
                    Review your selected frames, adjust quantities, and proceed to checkout.
                </p>
            </div>
            <% if (cartItems && cartItems.length > 0) { %>
                <div class="d-flex align-items-center flex-wrap gap-3">
                    <span id="cartCountBadge" class="cart-header-badge">
                        <%= totalItemCount %> Item<%= totalItemCount > 1 ? 's' : '' %>
                    </span>
                    <a href="/customer/frame-catalog" class="btn btn-secondary btn-sm cart-continue-btn">
                        👓 Continue Shopping
                    </a>
                </div>
            <% } %>
        </div>

        <div class="dashboard-body mt-4">
            <!-- Vue Island: CartView -->
            <div
                id="vue-cart"
                data-vue-component="CartView"
                data-vue-props='<%- JSON.stringify({ cartItems: cartItems || [], discount: locals.appliedDiscount || 0 }) %>'
            >
                <!-- SSR Fallback -->
                <% if (!cartItems || cartItems.length === 0) { %>
                    <div class="glass-panel cart-empty-panel">
                        <div class="cart-empty-icon">🛒</div>
                        <h3 class="cart-empty-title">Your Cart is Empty</h3>
                        <p class="cart-empty-desc">
                            Explore our catalog, try on frames virtually, or save your favorite glasses to fill up your cart!
                        </p>
                        <a href="/customer/frame-catalog" class="btn btn-primary cart-empty-cta">
                            <span>👓</span> Browse Frame Catalog
                        </a>
                    </div>
                <% } else { %>
                    <div class="cart-layout-grid">
                        <div class="cart-items-wrapper">
                            <div class="glass-panel desktop-cart-table-wrapper">
                                <div class="table-responsive">
                                    <table class="cart-table align-middle">
                                        <tbody>
                                            <% cartItems.forEach(item => { %>
                                                <tr class="cart-row-item">
                                                    <td class="cart-table-td-product">
                                                        <div class="cart-product-flex">
                                                            <div class="cart-item-thumb">
                                                                <img src="<%= item.frame_catalog_image %>" alt="<%= item.frame_name %>" class="img-fluid">
                                                            </div>
                                                            <div>
                                                                <h4 class="cart-item-title"><%= item.frame_name %></h4>
                                                                <span class="cart-item-brand"><%= item.brand %></span>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td class="cart-table-td-price">৳<%= Number(item.price).toFixed(2) %></td>
                                                    <td class="cart-table-td-qty"><%= item.quantity %></td>
                                                    <td class="cart-table-td-subtotal">৳<%= (item.price * item.quantity).toFixed(2) %></td>
                                                </tr>
                                            <% }); %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
    </section>
</div>

<%- include('../partials/footer') %>
