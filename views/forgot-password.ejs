<%- include('partials/header') %>
<section class="auth-section container-sm px-3 py-5">
    <div class="auth-box glass-panel card text-light border-0 shadow-lg p-4 p-md-5">
        <h2 class="card-title text-center">Forgot Password</h2>
        <form action="/forgot-password" method="POST">
            <div class="form-group mb-4">
                <label for="email" class="form-label">Enter your Email</label>
                <input type="email" id="email" name="email" class="form-control" autocomplete="email" required>
            </div>
            <div class="d-grid">
                <button type="submit" class="btn btn-primary btn-full w-100">Send Reset Link</button>
            </div>
        </form>
    </div>
</section>
<%- include('partials/footer') %>
