# Database settings (if applicable)
DB_PATH=./database.sqlite

# JWT settings
JWT_SECRET=your_super_secret_jwt_key_here

# SMTP Email Configuration
# Example for Gmail: you need to use an "App Password" if 2FA is enabled.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# Gemini API Key (free tier, e.g. from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=12000

# Cloudinary Configuration (free tier)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
# MapTiler API Key (free plan, e.g. from cloud.maptiler.com)
MAPTILER_API_KEY=your_maptiler_api_key_here

# Application Base URL (for payment callbacks)
BASE_URL=http://localhost:3000

# Stripe Test Mode Configuration (Free)
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_your_key_here

# SSLCommerz Sandbox Configuration (Free)
SSLCOMMERZ_STORE_ID=testbox
SSLCOMMERZ_STORE_PASSWORD=qwerty
SSLCOMMERZ_IS_SANDBOX=true
